{
  "name": "@build-a-bot/core",
  "version": "0.5.0",
  "description": "Core Build-A-Bot runtime.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "ENV=test FORCE_COLOR=1 vitest run --dir test",
    "test:brightdata": "ENV=integration vitest run --config vitest.brightdata.config.ts",
    "test:watch": "ENV=test FORCE_COLOR=1 vitest --dir test",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "@mastra/core": "^1.71.0",
    "@mastra/libsql": "^1.21.1",
    "@mastra/mcp": "^2.1.0",
    "@mastra/observability": "^1.17.1",
    "@mastra/redis": "^1.4.2",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "ioredis": "^6.0.0",
    "json-schema-to-ts": "^3.1.0",
    "node-html-parser": "^7.1.0",
    "p-queue": "^9.3.3",
    "playwright": "^1.58.2",
    "protobufjs": "^8.7.2",
    "radash": "^12.1.0",
    "tslog": "^5.1.0",
    "undici": "^7.24.4",
    "zod": "^4.6.7"
  }
}
